# Settings file for notifications. Keep it next to config.yaml (or jobwatch.exe).

# --- Phone notifications (recommended, no email account needed) ---
# 1. Install the free "ntfy" app (Android / iPhone).
# 2. Tap + and subscribe to a private, hard-to-guess name, e.g. your-private-topic-name-x7q2
# 3. Put the same name here:
NTFY_TOPIC=

# --- Email (optional) ---
# Gmail: create an app password at https://myaccount.google.com/apppasswords
# (needs 2-step verification), and paste it below. Your normal password won't work.

SMTP_USER=you@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
EMAIL_TO=you@gmail.com

# Only needed if you don't use Gmail:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
